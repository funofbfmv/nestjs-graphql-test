generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Profile {
  id          String       @id @default(uuid())
  name        String
  description String
  githubUrl   String?
  linkedinUrl String?

  skills      Skill[]
  experience  Experience[]
  projects    Project[]
}

model Skill {
  id        String  @id @default(uuid())
  name      String
  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, name])
}

model Experience {
  id           String   @id @default(uuid())
  company      String
  position     String
  startDate    DateTime
  endDate      DateTime?
  achievements String[]
  profileId    String
  profile      Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model Project {
  id          String  @id @default(uuid())
  name        String
  url         String
  description String?
  profileId   String
  profile     Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}